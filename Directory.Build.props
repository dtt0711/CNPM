<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Transitive EF/SqlClient advisories (NU190x) are suppressed until upstream bumps Pkcs. -->
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CS1591</NoWarn>
  </PropertyGroup>
</Project>
