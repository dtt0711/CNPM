# Base URL of the TourismHcm backend API (no trailing slash).
# Leave empty to use same-origin (Vite proxy in Dev, nginx in Docker).
VITE_API_BASE_URL=

# Where Vite proxies /api /audio /static during `npm run dev`.
# Local `dotnet run`:   http://localhost:5020
# Docker Compose API:   http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:5020

# MapLibre style URL or raster template. Empty = OSM raster built into MapView.
# With MapTiler: https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAPTILER_KEY=
