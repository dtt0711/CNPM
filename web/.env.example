# Base URL of the TourismHcm backend API (no trailing slash).
# In dev, Vite also proxies /api -> http://localhost:8080, so this can be left
# empty ("") to use same-origin relative requests through the proxy.
VITE_API_BASE_URL=

# MapLibre GL style/tile URL. Defaults to a public OSM-based demo style if unset.
# Examples:
#   https://demotiles.maplibre.org/style.json
#   https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY
VITE_MAP_TILE_URL=https://demotiles.maplibre.org/style.json
