# =============================================================================
# TourismHcm — copy to .env and fill values. Never commit .env.
# Fake TTS/Translate đã bị tắt. Runtime thật = Edge-TTS + Free Translate (sidecar).
# =============================================================================

# ---------- BẮT BUỘC (Docker Compose) ----------
MSSQL_SA_PASSWORD=Your_strong_Password123
JWT_SIGNING_KEY=DevOnly_ChangeMe_UseAtLeast32Chars_LongKey!

# Admin seed (Development)
ADMIN_EMAIL=admin@tourismhcm.local
ADMIN_PASSWORD=Admin123!ChangeMe

# Providers sidecar (Edge-TTS + deep-translator) — KHÔNG cần API key
# Trong Docker: API tự gọi http://providers:8090
# Khi chạy API bằng `dotnet run` trên máy host:
PROVIDERS_BASE_URL=http://localhost:8090

# Provider mode (không dùng Fake nữa)
# Translation: Free (sidecar, mặc định) | Google (cần key bên dưới)
TRANSLATION_PROVIDER=Free
# Speech: Edge (sidecar, mặc định) | Azure (cần key bên dưới)
SPEECH_PROVIDER=Edge

# ---------- TÙY CHỌN — chỉ điền nếu đổi sang Google Cloud / Azure ----------
GOOGLE_TRANSLATION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# ---------- TÙY CHỌN — AI Advisor (Owner enhance description) ----------
GEMINI_API_KEY=AIzaSyDNyS3hL46PoISNcqJa3X6kdCz2ws9kLXk
PROXYPAL_BASE_URL=

# ---------- TÙY CHỌN — bảo mật PII (base64 32-byte; trống = khóa dev dẫn xuất) ----------
PII_ENCRYPTION_KEY=IBSY00BK5o6RFVp8yT0ertEHWTSe8gStMqP9v9r1qMw=

# ---------- Frontend ----------
# Để trống = same-origin (Vite proxy hoặc nginx Docker)
VITE_API_BASE_URL=
# Proxy khi `npm run dev` — mặc định Docker API :8080
VITE_API_PROXY_TARGET=http://localhost:8080
# Bản đồ cloud (tuỳ chọn). Trống = OSM raster trong app.
VITE_MAP_TILE_URL=
VITE_MAPTILER_KEY=

# Map pack volume (Docker)
MAP_PACK_DATA_DIR=

# ---------- Deploy (CD) ----------
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=
GHCR_OWNER=
STAGING_URL=
PRODUCTION_URL=
