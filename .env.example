# Copy to .env and fill in values. Never commit .env or service-account JSON.

# SQL Server
MSSQL_SA_PASSWORD=Your_strong_Password123

# JWT (min 32 chars)
JWT_SIGNING_KEY=DevOnly_ChangeMe_UseAtLeast32Chars_LongKey!

# Default admin (seeded in Development)
ADMIN_EMAIL=admin@tourismhcm.local
ADMIN_PASSWORD=Admin123!ChangeMe

# Translation: Fake | Google
TRANSLATION_PROVIDER=Fake
GOOGLE_TRANSLATION_API_KEY=
# Or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Speech / TTS: Fake | Azure
SPEECH_PROVIDER=Fake
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Frontend map: leave empty for OpenFreeMap Liberty (clear street labels).
# Or set a MapLibre style JSON URL, or a raster template with {z}/{x}/{y}.
VITE_MAP_TILE_URL=
VITE_API_BASE_URL=
# Vite proxy target when using `npm run dev` (dotnet run = 5020, docker api = 8080)
VITE_API_PROXY_TARGET=http://localhost:5020

# Deploy (fill for CD / SSH deploy)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=
GHCR_OWNER=
STAGING_URL=
PRODUCTION_URL=
