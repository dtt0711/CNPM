{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "TourismHcm",
    "Audience": "TourismHcm.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Providers": {
    "BaseUrl": "http://localhost:8090",
    "TimeoutSeconds": 60
  },
  "Translation": {
    "Provider": "Free",
    "ApiKey": "",
    "Endpoint": null
  },
  "Speech": {
    "Provider": "Edge",
    "AzureKey": "",
    "AzureRegion": "",
    "Voices": {
      "vi": "vi-VN-HoaiMyNeural",
      "en": "en-US-JennyNeural",
      "ja": "ja-JP-NanamiNeural",
      "ko": "ko-KR-SunHiNeural",
      "zh": "zh-CN-XiaoxiaoNeural"
    }
  },
  "Ai": {
    "GeminiApiKey": "",
    "GeminiModel": "gemini-2.0-flash",
    "ProxyPalBaseUrl": "",
    "OwnerDailyLimit": 10,
    "TimeoutSeconds": 30
  },
  "MapPack": {
    "DataDir": "wwwroot/static/maps",
    "DefaultScope": "hcm"
  },
  "Pii": {
    "EncryptionKey": "",
    "RedactionDays": 180
  },
  "AudioStorage": {
    "RootPath": "audio-storage",
    "PublicBaseUrl": "/audio"
  },
  "Audio": {
    "MaxTextLength": 5000,
    "MaxRetries": 3
  },
  "Geofence": {
    "CooldownMinutes": 5,
    "DefaultRadiusMeters": 30,
    "MaxScanRadiusMeters": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
