{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=TourismHcm.Dev;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:8081"
    ]
  },
  "Jwt": {
    "Issuer": "TourismHcm",
    "Audience": "TourismHcm.Client",
    "SigningKey": "REPLACE_WITH_DEV_ONLY_PLACEHOLDER_SIGNING_KEY_NOT_FOR_PRODUCTION_32B",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Admin": {
    "Email": "admin@tourismhcm.local",
    "Password": "Admin123!ChangeMe"
  },
  "Providers": {
    "BaseUrl": "http://localhost:8090",
    "TimeoutSeconds": 60
  },
  "Translation": {
    "Provider": "Free",
    "ApiKey": ""
  },
  "Speech": {
    "Provider": "Edge",
    "AzureKey": "",
    "AzureRegion": ""
  },
  "Ai": {
    "GeminiApiKey": "",
    "OwnerDailyLimit": 10
  },
  "MapPack": {
    "DataDir": "wwwroot/static/maps",
    "DefaultScope": "hcm"
  },
  "AudioStorage": {
    "RootPath": "audio-storage",
    "PublicBaseUrl": "/audio"
  }
}
